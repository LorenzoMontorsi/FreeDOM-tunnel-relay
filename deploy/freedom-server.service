[Unit]
Description=FreeDOM tunnel server
After=network-online.target
Wants=network-online.target

[Service]
User=freedom
WorkingDirectory=/opt/freedom
EnvironmentFile=/etc/freedom/server.env
# Tunnel ports are unrestricted (1024-65535) by default; narrow them with e.g.
#   --tcp-ports 2102,20000-40000 --udp-ports 8000,2456-2458
ExecStart=/opt/freedom/freedom-server --http-bind 127.0.0.1 --ask-port 7836
Restart=always
RestartSec=2
# No artificial limits: allow a huge number of simultaneous connections.
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
